{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Both windows: core APIs plus window dragging for the frameless widget.",
  "windows": ["main", "widget"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "autostart:default"
  ]
}
